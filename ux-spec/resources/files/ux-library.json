    "EL-attribute-list": {
      "a11y": {
        "keyboard": [
          "Space",
          "Tab"
        ],
        "min_target_px": 48,
        "name_from": "content",
        "role": "group per requirement class (role=group labelled by its heading) containing a list of native checkboxes; readonly - a plain list (role=list) of label / value pairs, no controls"
      },
      "assets": [
        {
          "id": "icon.content-content-copy",
          "part": "copy button"
        }
      ],
      "event_controls": {
        "copy": "copy"
      },
      "events": [
        "copy",
        "toggle"
      ],
      "kind": "input",
      "maturity": "candidate",
      "name": "Requested attribute list",
      "partials": [
        {
          "each": "items",
          "element": "EL-attribute-item"
        }
      ],
      "props": {
        "copy_label": {
          "required": false,
          "type": "text"
        },
        "items": {
          "item": {
            "copyable": {
              "default": false,
              "description": "readonly only: a copy button after the value (named by copy_label + the label); drawn where the brand's detail-layout variant is cards (CAN-084)",
              "type": "boolean"
            },
            "id": {
              "description": "Stable attribute key (e.g. birth_date); exposed as data-item for events and tests",
              "required": false,
              "type": "id"
            },
            "label_copy": {
              "description": "Copy id of the attribute name in user terms (principle 5) — resolved through the copy table; G5 checks it exists",
              "required": true,
              "type": "copy"
            },
            "media": {
              "default": "none",
              "description": "readonly only: photo = the value is the accessible name of a portrait drawn in its place (a placeholder in the prototype; CAN-084)",
              "type": "enum",
              "values": [
                "none",
                "photo"
              ]
            },
            "requirement": {
              "description": "Ignored when readonly (nothing to choose)",
              "required": true,
              "type": "enum",
              "values": [
                "mandatory",
                "optional"
              ]
            },
            "selected": {
              "default": false,
              "description": "Initial checked state of an optional item; ignored for mandatory items. ARF: optional data unselected by default",
              "type": "boolean"
            },
            "value": {
              "description": "Value that would be shared (holder data, not product copy); omit to show only the label",
              "required": false,
              "type": "text"
            }
          },
          "required": true,
          "type": "list"
        },
        "mandatory_heading": {
          "required": false,
          "type": "text"
        },
        "mandatory_label": {
          "required": false,
          "type": "text"
        },
        "optional_heading": {
          "required": false,
          "type": "text"
        },
        "optional_label": {
          "required": false,
          "type": "text"
        },
        "readonly": {
          "default": false,
          "type": "boolean"
        }
      },
      "slots": [],
      "styles": {
        "pairs": {
          "attr": "pairs",
          "default": "stacked",
          "label": "Readonly label / value pairs",
          "options": {
            "columns": {
              "a11y": "reading order unchanged (label, then value); a pair too long for two columns at the text size stacks",
              "draws": [
                "label column",
                "value column"
              ],
              "label": "Two columns; a long pair stacks",
              "ref": "eDoklady data row, components/edoklady.css:925-938",
              "tokens": [
                "comp.attribute-list.pair-column-gap"
              ]
            },
            "stacked": {
              "draws": [
                "label",
                "value"
              ],
              "label": "Label over value",
              "ref": "DEC-021 (amended, eval-idsk-nl round 4)"
            }
          }
        }
      },
      "token_groups": [
        "comp.attribute-list"
      ]
    },
