    "rules": [
      {
        "id": "RUL-home-notifications-read",
        "then": [
          {
            "effect": "hide",
            "node": "appbar-unread"
          }
        ],
        "when": {
          "op": "is_false",
          "path": "/notifications/unread"
        }
      },
      {
        "id": "RUL-home-notifications-unread",
        "then": [
          {
            "effect": "hide",
            "node": "appbar"
          }
        ],
        "when": {
          "op": "is_true",
          "path": "/notifications/unread"
        }
      },
      {
        "id": "RUL-home-online",
        "then": [
          {
            "effect": "hide",
            "node": "notice-offline"
          },
          {
            "effect": "hide",
            "node": "notice-offline-phone"
          }
        ],
        "when": {
          "op": "is_true",
          "path": "/network/online"
        }
      },
      {
        "id": "RUL-home-storage-phone",
        "then": [
          {
            "effect": "hide",
            "node": "card-id"
          },
          {
            "effect": "hide",
            "node": "card-id-revoked"
          },
          {
            "effect": "hide",
            "node": "card-id-suspended"
          },
          {
            "effect": "hide",
            "node": "card-id-stale"
          },
          {
            "effect": "hide",
            "node": "card-dl"
          },
          {
            "effect": "hide",
            "node": "card-dl-expired"
          },
          {
            "effect": "hide",
            "node": "card-dl-expiring"
          }
        ],
        "when": {
          "op": "neq",
          "path": "/storage/selected",
          "value": "phone"
        }
      },
      {
        "id": "RUL-home-storage-cloud",
        "then": [
          {
            "effect": "hide",
            "node": "card-pid-cloud"
          }
        ],
        "when": {
          "op": "neq",
          "path": "/storage/selected",
          "value": "cloud"
        }
      },
      {
        "id": "RUL-home-document-valid",
        "then": [
          {
            "effect": "hide",
            "node": "card-dl-expired"
          }
        ],
        "when": {
          "op": "neq",
          "path": "/documents/dl_status",
          "value": "expired"
        }
      },
      {
        "id": "RUL-home-document-invalid",
        "then": [
          {
            "effect": "hide",
            "node": "card-dl"
          }
        ],
        "when": {
          "op": "eq",
          "path": "/documents/dl_status",
          "value": "expired"
        }
      },
      {
        "id": "RUL-home-all-valid",
        "then": [
          {
            "effect": "hide",
            "node": "notice-invalid"
          }
        ],
        "when": {
          "all": [
            {
              "op": "neq",
              "path": "/documents/dl_status",
              "value": "expired"
            },
            {
              "op": "eq",
              "path": "/documents/id_status",
              "value": "valid"
            }
          ]
        }
      },
      {
        "id": "RUL-home-id-valid",
        "then": [
          {
            "effect": "hide",
            "node": "card-id"
          }
        ],
        "when": {
          "op": "neq",
          "path": "/documents/id_status",
          "value": "valid"
        }
      },
      {
        "id": "RUL-home-id-revoked",
        "then": [
          {
            "effect": "hide",
            "node": "card-id-revoked"
          }
        ],
        "when": {
          "op": "neq",
          "path": "/documents/id_status",
          "value": "revoked"
        }
      },
      {
        "id": "RUL-home-id-suspended",
        "then": [
          {
            "effect": "hide",
            "node": "card-id-suspended"
          }
        ],
        "when": {
          "op": "neq",
          "path": "/documents/id_status",
          "value": "suspended"
        }
      },
      {
        "id": "RUL-home-id-stale",
        "then": [
          {
            "effect": "hide",
            "node": "card-id-stale"
          }
        ],
        "when": {
          "op": "neq",
          "path": "/documents/id_status",
          "value": "stale"
        }
      },
      {
        "id": "RUL-home-id-deleted",
        "then": [
          {
            "effect": "hide",
            "node": "card-id"
          },
          {
            "effect": "hide",
            "node": "card-id-revoked"
          },
          {
            "effect": "hide",
            "node": "card-id-suspended"
          },
          {
            "effect": "hide",
            "node": "card-id-stale"
          }
        ],
        "when": {
          "op": "is_false",
          "path": "/documents/id_present"
        }
      },
      {
        "id": "RUL-home-dl-deleted",
        "then": [
          {
            "effect": "hide",
            "node": "card-dl"
          },
          {
            "effect": "hide",
            "node": "card-dl-expired"
          },
          {
            "effect": "hide",
            "node": "card-dl-expiring"
          }
        ],
        "when": {
          "op": "is_false",
          "path": "/documents/dl_present"
        }
      },
      {
        "id": "RUL-home-pid-deleted",
        "then": [],
        "when": {
          "op": "is_false",
          "path": "/documents/pid_present"
        }
      },
      {
        "id": "RUL-home-not-empty",
        "then": [
          {
            "effect": "hide",
            "node": "empty-title"
          },
          {
            "effect": "hide",
            "node": "empty-text"
          },
          {
            "effect": "hide",
            "node": "add-document"
          }
        ],
        "when": {
          "op": "is_false",
          "path": "/documents/empty"
        }
      },
      {
        "id": "RUL-home-empty",
        "then": [
          {
            "effect": "hide",
            "node": "card-id"
          },
          {
            "effect": "hide",
            "node": "card-id-revoked"
          },
          {
            "effect": "hide",
            "node": "card-id-suspended"
          },
          {
            "effect": "hide",
            "node": "card-id-stale"
          },
          {
            "effect": "hide",
            "node": "card-dl"
          },
          {
            "effect": "hide",
            "node": "card-dl-expired"
          },
          {
            "effect": "hide",
            "node": "card-pid-cloud"
          },
          {
            "effect": "hide",
            "node": "present"
          }
        ],
        "when": {
          "op": "is_true",
          "path": "/documents/empty"
        }
      },
      {
        "id": "RUL-home-dl-expiring",
        "then": [
          {
            "effect": "hide",
            "node": "card-dl-expiring"
          }
        ],
        "when": {
          "op": "neq",
          "path": "/documents/dl_status",
          "value": "expiring"
        }
      },
      {
        "id": "RUL-home-dl-not-expiring",
        "then": [
          {
            "effect": "hide",
            "node": "card-dl"
          }
        ],
        "when": {
          "op": "eq",
          "path": "/documents/dl_status",
          "value": "expiring"
        }
      }
    ],
