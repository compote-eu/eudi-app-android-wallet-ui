# built application files
*.apk
*.ap_

# files for the dex VM
*.dex

# Java class files
*.class

# generated files
bin/
gen/
out/
build/

# Local configuration file (sdk path, etc)
local.properties

# Eclipse project files
.classpath
.project

# Mac thumbnail db
.DS_Store

# IDEA/Android Studio project files, because
# the project can be imported from settings.gradle.kts
*.iml
.idea/*
!.idea/copyright
# Keep the code styles.
!/.idea/codeStyles
/.idea/codeStyles/*
!/.idea/codeStyles/Project.xml
!/.idea/codeStyles/codeStyleConfig.xml

# Gradle cache
.gradle

# Android Studio captures folder
captures/

# Sign key
sign

# Local development CA / TLS material (generated by scripts/generate-local-dev-ca.sh).
# Each developer generates their own; private keys must never be committed.
network-logic/.local-dev-ca/
network-logic/src/local/res/raw/local_dev_ca.pem

# Local services stack (docker-compose) — per-developer env, secrets, keys, DB schemas.
local-services/.env
local-services/config/
local-services/repos/

# fastlane
.env.demo
.env.dev
fastlane/report.xml

# Kotlin
.kotlin/*