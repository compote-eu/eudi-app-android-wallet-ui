<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Content providers run before Application.onCreate, where Koin starts; the provider only registers a
             lifecycle callback, which loads the hook module once the first activity is being created. -->
        <provider
            android:name="eu.europa.ec.uxspike.android.UxSpikeInitProvider"
            android:authorities="${applicationId}.ux-spike-init"
            android:exported="false" />
    </application>
</manifest>
