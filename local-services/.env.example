# Copy to `.env` (git-ignored) and adjust.
#
# LOCAL_IP MUST match:
#   - `localIp` in ../local.properties (so BuildConfig.LOCAL_IP matches), and
#   - the SAN of the generated server cert (regenerate with
#     `../gradlew :network-logic:generateLocalServerCert -PhostIp=<ip> -Pforce`).
LOCAL_IP=192.168.1.242

# PostgreSQL passwords (local dev). wallet-db = core; trustedlist-db only with --profile trustedlist.
WALLET_DB_PASSWORD=postgres
TRUSTEDLIST_DB_PASSWORD=postgres

# Password protecting the wallet-provider signing keystore (config/wallet-provider/signing.p12).
SIGNINGKEY_PASSWORD=changeit

# RQES (TrustProvider Signer) MySQL — only used with `--profile rqes`.
# Keep these in sync with the DB settings in repos/trustprovider-signer/.env
# (its DB host must be `rqes-db`).
RQES_DB_NAME=signer
RQES_DB_USER=signer
RQES_DB_PASSWORD=signer
RQES_DB_ROOT_PASSWORD=rootpw

# API key the wallet-provider uses to call the Token Status List service
# (eudi-srv-statuslist-py). Its default X-API-Key is "test".
STATUSLIST_API_KEY=test
