   "rules": [
    {
     "id": "RUL-home-notifications-read",
     "when": {
      "path": "/notifications/unread",
      "op": "is_false"
     },
     "then": [
      {
       "effect": "hide",
       "node": "appbar-unread"
      }
     ]
    },
    {
     "id": "RUL-home-notifications-unread",
     "when": {
      "path": "/notifications/unread",
      "op": "is_true"
     },
     "then": [
      {
       "effect": "hide",
       "node": "appbar"
      }
     ]
    },
    {
     "id": "RUL-home-online",
     "when": {
      "path": "/network/online",
      "op": "is_true"
     },
     "then": [
      {
       "effect": "hide",
       "node": "notice-offline"
      },
      {
       "effect": "hide",
       "node": "notice-offline-phone"
      }
     ]
    },
    {
     "id": "RUL-home-storage-phone",
     "when": {
      "path": "/storage/selected",
      "op": "neq",
      "value": "phone"
     },
     "then": [
      {
       "effect": "hide",
       "node": "card-id"
      },
      {
       "effect": "hide",
       "node": "card-id-revoked"
      },
      {
       "effect": "hide",
       "node": "card-id-suspended"
      },
      {
       "effect": "hide",
       "node": "card-id-stale"
      },
      {
       "effect": "hide",
       "node": "card-dl"
      },
      {
       "effect": "hide",
       "node": "card-dl-expired"
      },
      {
       "effect": "hide",
       "node": "card-dl-expiring"
      },
      {
       "effect": "hide",
       "node": "card-pid"
      },
      {
       "effect": "hide",
       "node": "documents-heading"
      },
      {
       "effect": "hide",
       "node": "all-documents"
      }
     ]
    },
    {
     "id": "RUL-home-storage-cloud",
     "when": {
      "path": "/storage/selected",
      "op": "neq",
      "value": "cloud"
     },
     "then": [
      {
       "effect": "hide",
       "node": "card-pid-cloud"
      }
     ]
    },
    {
     "id": "RUL-home-document-valid",
     "when": {
      "path": "/documents/dl_status",
      "op": "neq",
      "value": "expired"
     },
     "then": [
      {
       "effect": "hide",
       "node": "card-dl-expired"
      }
     ]
    },
    {
     "id": "RUL-home-document-invalid",
     "when": {
      "path": "/documents/dl_status",
      "op": "eq",
      "value": "expired"
     },
     "then": [
      {
       "effect": "hide",
       "node": "card-dl"
      }
     ]
    },
    {
     "id": "RUL-home-all-valid",
     "when": {
      "all": [
       {
        "path": "/documents/dl_status",
        "op": "neq",
        "value": "expired"
       },
       {
        "path": "/documents/id_status",
        "op": "eq",
        "value": "valid"
       }
      ]
     },
     "then": [
      {
       "effect": "hide",
       "node": "notice-invalid"
      }
     ]
    },
    {
     "id": "RUL-home-id-valid",
     "when": {
      "path": "/documents/id_status",
      "op": "neq",
      "value": "valid"
     },
     "then": [
      {
       "effect": "hide",
       "node": "card-id"
      }
     ]
    },
    {
