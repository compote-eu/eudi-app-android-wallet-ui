diff --git a/ux/product/rules/RUL-pres-expired-verifier-visible.yaml b/ux/product/rules/RUL-pres-expired-verifier-visible.yaml
new file mode 100644
index 0000000..ccff137
--- /dev/null
+++ b/ux/product/rules/RUL-pres-expired-verifier-visible.yaml
@@ -0,0 +1,7 @@
+id: RUL-pres-expired-verifier-visible
+description: The expired outcome's verifier notice (the verifier's name as its title, "Overenie spustite znovu na stránke tohto overovateľa.") is shown only when the verifier is known — the request expired after it was loaded. When it expired while loading, no name exists and the whole notice is hidden.
+maturity: candidate
+when: {path: /verifier/name, op: is_empty}
+then:
+  - {effect: hide, node: verifier}
+satisfies: ["UXR:REQ-PRES-014"]
