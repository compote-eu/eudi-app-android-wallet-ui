diff --git a/ux/experience/screens/SCR-pres-offline-loading.yaml b/ux/experience/screens/SCR-pres-offline-loading.yaml
new file mode 100644
index 0000000..27d4097
--- /dev/null
+++ b/ux/experience/screens/SCR-pres-offline-loading.yaml
@@ -0,0 +1,24 @@
+id: SCR-pres-offline-loading
+name: Offline while loading the request
+purpose: Recovery step when the device has no network connection while the verifier's request loads (D8-offline) — says that nothing has been shared and that the request loads again once the phone is online; the user retries or cancels.
+template: TPL-outcome
+maturity: candidate
+brief: BRF-001
+data_model: {}
+nodes:
+  - id: hero
+    element: EL-status-hero
+    region: hero
+    props: {tone: warning, title: {copy: CPY-pres-offline-title}, text: {copy: CPY-pres-offline-text}}
+    satisfies: ["UXR:REQ-PRES-014"]
+  - {id: retry, element: EL-button, region: actions, props: {variant: primary, label: {copy: CPY-pres-offline-retry}}}
+  - {id: cancel, element: EL-button, region: actions, props: {variant: secondary, label: {copy: CPY-pres-offline-cancel}}}
+events:
+  - {node: retry, on: press, emits: RETRY}
+  - {node: cancel, on: press, emits: CANCEL}
+ui_states:
+  - {id: default, description: "No network while the request loads; Skúsiť znova fetches the request again (RETRY -> connecting), Zrušiť ends the presentation before anything is shared"}
+satisfies:
+  - "UXR:REQ-PRES-014"
+sources:
+  - {source: SRC-ARF-5.01, ref: "L509 §2.9", note: plain-language error with a way to recover}
